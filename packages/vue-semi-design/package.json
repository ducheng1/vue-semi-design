{
  "name": "vue-semi-design",
  "type": "module",
  "version": "0.0.1-alpha.8",
  "description": "Vue3 component library in semi design style",
  "author": {
    "name": "ducheng1",
    "email": "w729567588@163.com"
  },
  "license": "MIT",
  "homepage": "https://vsd.dcwedu.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducheng1/vue-semi-design.git"
  },
  "bugs": {
    "url": "https://github.com/ducheng1/vue-semi-design/issues"
  },
  "keywords": [
    "semi design",
    "vue",
    "component library",
    "ui library"
  ],
  "exports": {
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./styles/*": "./dist/es/styles/*",
    "./umd/*": "./dist/umd/*",
    "./es/*": "./dist/es/*"
  },
  "main": "./dist/umd/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "style": "./dist/umd/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run clean && rslib build --watch",
    "build": "pnpm run clean && rslib build && vue-tsc",
    "release": "bumpp --preid alpha --tag 'v' --push",
    "update-version": "tsx ./scripts/update-version.ts",
    "postversion": "pnpm run update-version && git add ./src/version.ts && git commit -m 'chore: update version'",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "@vue-semi-design/icons": "catalog:",
    "es-toolkit": "catalog:"
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-sass": "catalog:",
    "@rsbuild/plugin-vue": "catalog:",
    "@rslib/core": "catalog:",
    "@vueuse/components": "catalog:",
    "@vueuse/core": "catalog:",
    "autoprefixer": "catalog:",
    "cssnano": "catalog:",
    "rsbuild-plugin-unplugin-vue": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
