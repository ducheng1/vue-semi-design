{
  "name": "@vue-semi-design/icons",
  "type": "module",
  "version": "1.0.3",
  "description": "vue semi design icons",
  "author": {
    "name": "ducheng1",
    "email": "w729567588@163.com"
  },
  "license": "MIT",
  "homepage": "https://vsd.dcwedu.top",
  "repository": {
    "type": "git",
    "url": "https://github.com/ducheng1/vue-semi-design.git"
  },
  "bugs": {
    "url": "https://github.com/ducheng1/vue-semi-design/issues"
  },
  "keywords": [
    "semi design",
    "vue",
    "icon library",
    "icons"
  ],
  "exports": {
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./umd/*": "./dist/umd/*",
    "./es/*": "./dist/es/*",
    "./svg/*": "./dist/es/svg/*"
  },
  "main": "./dist/umd/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "style": "./dist/umd/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run clean && rslib build --watch",
    "build": "pnpm run clean && rslib build && vue-tsc",
    "release": "bumpp --preid alpha --tag 'icons-v' --push",
    "update-version": "tsx ./scripts/update-version.ts && git add ./src/version.ts && git commit -m 'chore: update version'",
    "postversion": "pnpm run update-version",
    "clean": "rimraf dist",
    "optimize": "svgo -f ./src/svg -o ./src/svg",
    "generate": "tsx ./scripts/generate.ts"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "es-toolkit": "catalog:"
  },
  "devDependencies": {
    "@rsbuild/plugin-vue": "catalog:",
    "@rslib/core": "catalog:",
    "rsbuild-plugin-unplugin-vue": "catalog:",
    "svgo": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
