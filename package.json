{
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "description": "vue semi design monorepo",
  "author": {
    "name": "ducheng1",
    "email": "w729567588@163.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev & pnpm run dev:storybook",
    "dev:storybook": "storybook dev -p 5610 --no-open",
    "build": "turbo run build",
    "lint": "npm-run-all -p lint:*",
    "format": "prettier . --write --cache --ignore-unknown",
    "lint:code": "eslint . --fix --cache --cache-location=node_modules/.cache/eslint/",
    "lint:style": "stylelint **/*.{scss,vue} --fix --cache --cache-location=node_modules/.cache/stylelint/",
    "test": "vitest run",
    "commit": "git-cz",
    "preinstall": "npx only-allow pnpm",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "depcheck": "pnpx taze major -wIr",
    "reinstall": "node ./scripts/clean.js && pnpm install",
    "release:lib": "pnpm run --filter vue-semi-design release",
    "release:icons": "pnpm run --filter @vue-semi-design/icons release",
    "svg:optimize": "pnpm run --filter @vue-semi-design/icons optimize",
    "svg:generate": "pnpm run --filter @vue-semi-design/icons generate && pnpm lint:code"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-essentials": "catalog:",
    "@storybook/addon-interactions": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/addon-onboarding": "catalog:",
    "@storybook/blocks": "catalog:",
    "@storybook/test": "catalog:",
    "@storybook/vue3": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/vue": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "bumpp": "catalog:",
    "commitizen": "catalog:",
    "cz-git": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "glob": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "npm-run-all2": "catalog:",
    "postcss-html": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "storybook": "catalog:",
    "storybook-vue3-rsbuild": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-clean-order": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
